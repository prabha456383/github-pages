#include <iostream>

using namespace std;

int main() {
    int start, end, count = 0;
    
    cout << "Enter the start of the range: ";
    cin >> start;
    
    cout << "Enter the end of the range: ";
    cin >> end;
    
    for (int i = start; i <= end; i++) {
        if (i % 2 != 0) { // Check if the number is odd
            count++;
        }
    }
    
    cout << "Number of odd numbers in the range: " << count << endl;
    
    return 0;
}
